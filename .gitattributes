# git-crypt
# files starting with __SECRET__
# This does not consider the root content - nested only
# */__SECRET__* filter=git-crypt diff=git-crypt
**/__SECRET__* filter=git-crypt diff=git-crypt

# folders starting with __SECRET__
# */__SECRET__*/** filter=git-crypt diff=git-crypt
**/__SECRET__*/** filter=git-crypt diff=git-crypt
